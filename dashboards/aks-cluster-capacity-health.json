  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cluster Capacity & Node Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "azure-managed-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Total Nodes (Ready / Total)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition='Ready',status='true'})",
          "legendFormat": "Ready Nodes",
          "refId": "A"
        },
        {
          "expr": "count(kube_node_info)",
          "legendFormat": "Total Nodes",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "azure-managed-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }, "unit": "percent" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Cluster CPU Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode='idle'}[5m]))) * 100",
          "legendFormat": "Avg CPU Util",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "azure-managed-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 }] }, "unit": "percent" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Cluster Memory Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "(1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Avg Memory Util",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "azure-managed-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Pods Crashing (Last 5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(kube_pod_container_status_restarts_total[5m]) * 60 > 0) or vector(0)",
          "legendFormat": "Crashing Pods",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "title": "Node Saturation Trends",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "azure-managed-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "title": "CPU Usage per Node",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - sum by(instance) (rate(node_cpu_seconds_total{mode='idle'}[5m])) / sum by(instance) (rate(node_cpu_seconds_total[5m]))) * 100",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "azure-managed-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "title": "Memory Usage per Node",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "tags": ["aks", "kubernetes", "sre", "azure"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "AKS Cluster Capacity & Node Health",
  "uid": "aks-cluster-health-overview"
}
